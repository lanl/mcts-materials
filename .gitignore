.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/

# Virtual environments
.venv/

# OS
.DS_Store

# Embargoed/large data - do not commit until public release. DOS/energy data
# (DOSCAR peak CSVs, projected-DOS HDF5 exports, raw DOSCARs, MACE caches,
# precomputed r_DOS tables) is read locally from paths given in the config;
# keep it under data/ or anywhere outside the tree.
doscar_peaks_data_with_U*.csv
high_throughput_mace_results*.csv
rdos_bandpass*.csv
*_doscar_list.csv
DOSCAR*
*.h5
*.hdf5
*.db
*.tar.gz
*.tgz
*.zip
data/

# MCTS run outputs (regenerate locally with mcts-run)
mcts_results*/
results_*/
*.pkl

# Kept-aside reference material: sensitivity-sweep raw data/checkpoints
reference/sensitivity_studies/results/**/*.csv
reference/sensitivity_studies/results/**/*.json

# Environment variables (contains API keys)
.env

# Any files with "secret" or "key" in the name
*secret*
*key*.txt
archive/
